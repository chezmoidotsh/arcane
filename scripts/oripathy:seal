# ----------------------------------------------------------------------------
# mise alias="oripathy:seal"
# mise description="Encrypt the Oripathy BOM bundle for its public release asset (format of the n8n Crypto node)."
#
# The bundle describes the whole infrastructure and is published as a release asset of a public repository, so it is
# encrypted. The format is the one the n8n Crypto node (v2, symmetric, aes-256-gcm) decrypts, so n8n needs nothing else:
#     base64( 0x01 | salt(16) | iv(12) | tag(16) | ciphertext ),  key = scrypt(passphrase, salt, N=65536, r=8, p=1)
# The SHA-256 of the *decrypted* bundle is published next to it: n8n compares it with the last one it handled (nothing
# changed: nothing to download) and checks it after decrypting. The passphrase is read from $ORIPATHY_BOM_KEY, never
# from the command line. Needs the `cryptography` package (pip install cryptography).
#
# Usage: scripts/oripathy:seal seal bundle.json bundle.json.enc bundle.sha256
#        scripts/oripathy:seal open bundle.json.enc            (plaintext on stdout, for debugging)
#        scripts/oripathy:seal --self-test
import base64
import hashlib
import os
import sys

from cryptography.hazmat.primitives.ciphers.aead import AESGCM

VERSION, SALT, IV, TAG = 1, 16, 12, 16
SCRYPT = {"n": 65536, "r": 8, "p": 1, "maxmem": 128 * 1024 * 1024, "dklen": 32}


def key_of(passphrase, salt):
    return hashlib.scrypt(passphrase.encode(), salt=salt, **SCRYPT)


def seal(passphrase, data):
    salt, iv = os.urandom(SALT), os.urandom(IV)
    sealed = AESGCM(key_of(passphrase, salt)).encrypt(iv, data, None)  # ciphertext | tag
    return base64.b64encode(bytes([VERSION]) + salt + iv + sealed[-TAG:] + sealed[:-TAG]).decode() + "\n"


def unseal(passphrase, text):
    raw = base64.b64decode(text)
    if raw[:1] != bytes([VERSION]) or len(raw) < 1 + SALT + IV + TAG:
        raise ValueError("not an Oripathy sealed bundle (version byte or length)")
    salt, iv, tag, body = raw[1:1 + SALT], raw[1 + SALT:1 + SALT + IV], raw[1 + SALT + IV:1 + SALT + IV + TAG], raw[1 + SALT + IV + TAG:]
    return AESGCM(key_of(passphrase, salt)).decrypt(iv, body + tag, None)


def passphrase():
    key = os.environ.get("ORIPATHY_BOM_KEY")
    if not key:
        sys.exit("error: ORIPATHY_BOM_KEY is not set")
    return key


def self_test():
    data = b'{"format":"oripathy-boms"}\n'
    text = seal("s3cret", data)
    assert unseal("s3cret", text) == data
    try:
        unseal("other", text)
    except Exception:
        pass
    else:
        raise AssertionError("a wrong passphrase must not decrypt")
    assert seal("s3cret", data) != text  # fresh salt and iv every time
    print("self-test ok")


def main(argv):
    if argv[:1] == ["--self-test"]:
        self_test()
    elif argv[:1] == ["seal"] and len(argv) == 4:
        with open(argv[1], "rb") as f:
            data = f.read()
        with open(argv[2], "w") as f:
            f.write(seal(passphrase(), data))
        with open(argv[3], "w") as f:
            f.write(hashlib.sha256(data).hexdigest() + "\n")
    elif argv[:1] == ["open"] and len(argv) == 2:
        with open(argv[1]) as f:
            sys.stdout.buffer.write(unseal(passphrase(), f.read()))
    else:
        sys.exit(__doc__ and "usage: oripathy:seal seal <bundle> <out.enc> <out.sha256> | open <file.enc> | --self-test")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
