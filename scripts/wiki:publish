# ----------------------------------------------------------------------------
# mise alias="wiki:publish"
# mise description="Prepare docs/ for publication to the GitHub Wiki (copy the migrated pages, rewrite their links)."
#
# docs/ is the source of truth and is written with relative links to `.md` files, which work when browsing Git. The
# GitHub Wiki serves a page at /<owner>/<repo>/wiki/<path without .md>, so this script copies the pages that are not
# listed in docs/.wiki-legacy into DST and rewrites every relative link:
#   - to a published page        -> /<owner>/<repo>/wiki/<path without .md>[#anchor]
#   - to any other file of repo  -> https://github.com/<owner>/<repo>/blob/main/<path>[#anchor]
# DST is then what the wiki action pushes. Standard library only.
#
# Usage: scripts/wiki:publish SRC DST [--repo owner/name] [--repo-root .] | --self-test
import argparse
import fnmatch
import os
import re
import shutil
import sys
import tempfile
from pathlib import Path
from urllib.parse import unquote

LINK_RE = re.compile(r"(!?\[[^\]]*\]\(<?)([^)\s>]+)(>?(?:\s+(?:\"[^\"]*\"|'[^']*'))?\))")  # inline link or image
REF_RE = re.compile(r"^(\s{0,3}\[[^\]]+\]:\s*<?)([^\s>]+)(.*)$")  # reference definition: [id]: target
CODE_RE = re.compile(r"(`[^`]*`)")
FENCE_RE = re.compile(r"^\s*(```|~~~)")


def published_pages(src: Path) -> list[Path]:
    f = src / ".wiki-legacy"
    pats = [ln.strip() for ln in f.read_text(encoding="utf-8").splitlines()] if f.is_file() else []
    pats = [p for p in pats if p and not p.startswith("#")]
    return [p for p in sorted(src.rglob("*.md")) if not any(fnmatch.fnmatch(p.relative_to(src).as_posix(), x) for x in pats)]


def rewrite(text: str, page: Path, src: Path, pages: set[Path], repo: str, repo_root: Path) -> str:
    def fix(target: str, image: bool) -> str:
        """Return the wiki-ready URL for a relative target, or the target unchanged."""
        if re.match(r"^([a-z][a-z0-9+.-]*:|#)", target, re.I):
            return target
        path, _, anchor = target.partition("#")
        dest = (page.parent / unquote(path)).resolve()
        frag = f"#{anchor}" if anchor else ""
        if dest in pages:
            return f"/{repo}/wiki/{dest.relative_to(src).with_suffix('').as_posix()}{frag}"
        if dest.is_file() and repo_root in dest.parents:
            # blob/ serves an HTML page, an image needs the raw file
            kind = "raw" if image else "blob"
            return f"https://github.com/{repo}/{kind}/main/{dest.relative_to(repo_root).as_posix()}{frag}"
        return target

    def sub(m: re.Match) -> str:
        return f"{m.group(1)}{fix(m.group(2), m.group(1).startswith('!'))}{m.group(3)}"

    out, fenced = [], False
    for line in text.split("\n"):
        if FENCE_RE.match(line):
            fenced = not fenced
        elif not fenced:
            if m := REF_RE.match(line):
                line = f"{m.group(1)}{fix(m.group(2), False)}{m.group(3)}"
            else:
                # inline code spans (odd items) are left untouched
                line = "".join(p if i % 2 else LINK_RE.sub(sub, p) for i, p in enumerate(CODE_RE.split(line)))
        out.append(line)
    return "\n".join(out)


def publish(src: Path, dst: Path, repo: str, repo_root: Path) -> int:
    src, repo_root = src.resolve(), repo_root.resolve()
    pages = published_pages(src)
    known = set(p.resolve() for p in pages)
    if dst.exists():
        shutil.rmtree(dst)
    for page in pages:
        target = dst / page.relative_to(src)
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(rewrite(page.read_text(encoding="utf-8"), page.resolve(), src, known, repo, repo_root), encoding="utf-8")
    return len(pages)


def self_test() -> None:
    with tempfile.TemporaryDirectory() as d:
        root = Path(d)
        (root / "docs" / "guides").mkdir(parents=True)
        (root / "docs" / "old").mkdir()
        (root / "projects").mkdir()
        (root / "projects" / "x.md").write_text("x")
        (root / "docs" / "old" / "a.md").write_text("legacy")
        (root / "docs" / ".wiki-legacy").write_text("old/*\n")
        (root / "docs" / "Home.md").write_text("[g](guides/Page.md#top) [p](../projects/x.md) [o](old/a.md) [e](https://e.org)\n")
        (root / "projects" / "i.svg").write_text("<svg/>")
        (root / "docs" / "guides" / "Page.md").write_text(
            "[h](../Home.md)\n```\n[h](../Home.md)\n```\n"
            "![img](../../projects/i.svg) [t](../Home.md 'title') [a](<../Home.md>) `[c](../Home.md)`\n"
            "[ref]: ../Home.md#x\n")
        n = publish(root / "docs", root / "out", "o/r", root)
        assert n == 2, n
        home = (root / "out" / "Home.md").read_text()
        assert "(/o/r/wiki/guides/Page#top)" in home, home
        assert "(https://github.com/o/r/blob/main/projects/x.md)" in home, home
        assert "(https://github.com/o/r/blob/main/docs/old/a.md)" in home, home
        assert "(https://e.org)" in home, home
        page = (root / "out" / "guides" / "Page.md").read_text()
        assert page.startswith("[h](/o/r/wiki/Home)") and "```\n[h](../Home.md)\n```" in page, page
        assert "![img](https://github.com/o/r/raw/main/projects/i.svg)" in page, page  # images need raw/, not blob/
        assert "[t](/o/r/wiki/Home 'title')" in page and "[a](</o/r/wiki/Home>)" in page, page
        assert "`[c](../Home.md)`" in page, page  # inline code untouched
        assert "[ref]: /o/r/wiki/Home#x" in page, page
        assert not (root / "out" / "old").exists()
    print("self-test ok")


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("src", nargs="?")
    ap.add_argument("dst", nargs="?")
    ap.add_argument("--repo", default=os.environ.get("GITHUB_REPOSITORY", "chezmoidotsh/arcane"))
    ap.add_argument("--repo-root", default=".")
    ap.add_argument("--self-test", action="store_true")
    args = ap.parse_args()
    if args.self_test:
        self_test()
        return 0
    if not (args.src and args.dst):
        ap.error("SRC and DST are required")
    n = publish(Path(args.src), Path(args.dst), args.repo, Path(args.repo_root))
    print(f"{n} page(s) prepared in {args.dst}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
