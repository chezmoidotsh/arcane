---
# Traefik Dynamic Configuration
# Managed by Ansible - DO NOT EDIT MANUALLY

http:
  middlewares:
    redirect-to-https:
      redirectScheme:
        scheme: https
    # Error pages middleware
    error-pages:
      errors:
        status:
          - "400-599"
        service: error-pages-service
        query: "/{status}.html"

  routers:
    # HTTP to HTTPS redirect router
    main-app-router-redirect:
      rule: "{% for domain in pangolin_domains %}Host(`{{ domain }}`){% if not loop.last %} || {% endif %}{% endfor %}"
      service: next-service
      entryPoints:
        - web
      middlewares:
        - redirect-to-https

    # Next.js router (handles everything except API and WebSocket paths)
    next-router:
      rule: "({% for domain in pangolin_domains %}Host(`{{ domain }}`){% if not loop.last %} || {% endif %}{% endfor %}) && !PathPrefix(`/api/v1`)"
      service: next-service
      entryPoints:
        - websecure
      middlewares:
        - error-pages
      tls:
        certResolver: letsencrypt

    # API router (handles /api/v1 paths)
    api-router:
      rule: "({% for domain in pangolin_domains %}Host(`{{ domain }}`){% if not loop.last %} || {% endif %}{% endfor %}) && PathPrefix(`/api/v1`)"
      service: api-service
      entryPoints:
        - websecure
      middlewares:
        - error-pages
      tls:
        certResolver: letsencrypt

    # WebSocket router
    ws-router:
      rule: "{% for domain in pangolin_domains %}Host(`{{ domain }}`){% if not loop.last %} || {% endif %}{% endfor %}"
      service: api-service
      entryPoints:
        - websecure
      middlewares:
        - error-pages
      tls:
        certResolver: letsencrypt

  services:
    next-service:
      loadBalancer:
        servers:
          - url: "http://pangolin:3002" # Next.js server

    api-service:
      loadBalancer:
        servers:
          - url: "http://pangolin:3000" # API/WebSocket server

    error-pages-service:
      loadBalancer:
        servers:
          - url: "http://error-pages:8080" # Error pages server
