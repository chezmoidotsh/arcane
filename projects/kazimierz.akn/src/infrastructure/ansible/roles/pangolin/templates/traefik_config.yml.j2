---
# Traefik Static Configuration
# Managed by Ansible - DO NOT EDIT MANUALLY

accessLog:
  filePath: "/var/log/traefik/access.log"
  format: "json"
  bufferingSize: 100
  filters:
    statusCodes:
      - "200-299"
      - "400-499"
      - "500-599"
    retryAttempts: true
    minDuration: "100ms"
  fields:
    defaultMode: "drop"
    names:
      ClientAddr: "keep"
      ClientHost: "keep"
      DownstreamContentSize: "keep"
      DownstreamStatus: "keep"
      Duration: "keep"
      RequestMethod: "keep"
      RequestPath: "keep"
      RequestProtocol: "keep"
      RetryAttempts: "keep"
      ServiceName: "keep"
      StartUTC: "keep"
      TLSCipher: "keep"
      TLSVersion: "keep"
    headers:
      defaultMode: "drop"
      names:
        Authorization: "redact"
        Content-Type: "keep"
        Cookie: "redact"
        User-Agent: "keep"
        X-Forwarded-For: "keep"
        X-Forwarded-Proto: "keep"
        X-Real-Ip: "keep"

api:
  insecure: true
  dashboard: true

providers:
  http:
    endpoint: "http://pangolin:3001/api/v1/traefik-config"
    pollInterval: "5s"
  file:
    filename: "/etc/traefik/dynamic_config.yml"

experimental:
  plugins:
    badger:
      moduleName: "github.com/fosrl/badger"
      version: "v1.2.0"

log:
  level: "{{ pangolin_log_level | upper }}"
  format: "common"

certificatesResolvers:
  letsencrypt:
    acme:
{% if pangolin_acme_wildcard_domain %}
      # DNS-01 -- required for wildcard certs (Let's Encrypt only issues
      # wildcards through DNS-01). Provider credentials are passed to the
      # traefik container as CF_DNS_API_TOKEN (see docker-compose.yml.j2).
      dnsChallenge:
        provider: cloudflare
{% else %}
      httpChallenge:
        entryPoint: web
{% endif %}
      email: {{ pangolin_acme_email }}
      storage: "/letsencrypt/acme.json"
      caServer: "{{ pangolin_acme_ca_server }}"

entryPoints:
  web:
    address: ":{{ pangolin_http_port }}"
  websecure:
    address: ":{{ pangolin_https_port }}"
    transport:
      respondingTimeouts:
        readTimeout: "30m"
    http:
      middlewares:
        - error-pages@file
      tls:
        certResolver: "letsencrypt"
{% if pangolin_acme_wildcard_domain %}
        # Eagerly requests one wildcard cert at startup instead of Traefik
        # trying to mint a cert per literal SNI -- also becomes this
        # entrypoint's default cert for any unmatched Host (see
        # dynamic_config.yml.j2's catchall-router).
        domains:
          - main: "{{ pangolin_acme_wildcard_domain }}"
            sans:
              - "*.{{ pangolin_acme_wildcard_domain }}"
{% endif %}

serversTransport:
  insecureSkipVerify: true

ping:
    entryPoint: "web"
