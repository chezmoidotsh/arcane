#!/usr/bin/env bash
# [MISE] description="Push the latest built arm64 qcow2 to OCI Object Storage and import it as a custom image"
# [MISE] depends=["image:build:arm64"]
# [MISE] dir="{{config_root}}"

set -euo pipefail

CONFIG_ROOT="$(pwd)"

# Matches the abandoned Crossplane design's bucket (see README.md, "Build +
# push the arm64 image to OCI") -- not yet recreated in the Pulumi stack.
NAMESPACE="ax25b8ybxdyk"
BUCKET="sh-chezmoi-akn-kazimierz-nixos"
CHEZMOI_SH_ID="ocid1.compartment.oc1..aaaaaaaajyh7a5rbs3gcnvmxffcwewtuftrakz5ndd6ojwxcjyjecuvnafaq"

# Picks the most recently built file rather than recomputing today's date --
# avoids a midnight race against image:build:arm64's own $(date) and lets you
# push a build from an earlier day without rebuilding.
IMAGE_FILE=$(ls -t "${CONFIG_ROOT}"/kazimierz.*-arm64.qcow2 2>/dev/null | head -1 || true)
if [[ -z ${IMAGE_FILE} ]]; then
  echo "ERROR: no kazimierz.*-arm64.qcow2 found in ${CONFIG_ROOT} -- run 'mise run image:build:arm64' first" >&2
  exit 1
fi
IMAGE_NAME="$(basename "${IMAGE_FILE}" .qcow2)"

echo "Resolving kazimierz.akn compartment OCID..."
COMPARTMENT_ID=$(oci iam compartment list --compartment-id "${CHEZMOI_SH_ID}" \
  --query "data[?name=='kazimierz.akn'].id | [0]" --raw-output)
if [[ -z ${COMPARTMENT_ID} || ${COMPARTMENT_ID} == "null" ]]; then
  echo "ERROR: kazimierz.akn compartment not found under ${CHEZMOI_SH_ID} -- has stack/oci/compartments.ts been applied (pulumi up)?" >&2
  exit 1
fi

echo "Uploading ${IMAGE_FILE} to oci://${BUCKET}/${IMAGE_NAME}.qcow2..."
oci os object put --namespace "${NAMESPACE}" --bucket-name "${BUCKET}" \
  --name "${IMAGE_NAME}.qcow2" --file "${IMAGE_FILE}" --force

echo "Importing as a custom compute image..."
IMAGE_OCID=$(oci compute image import from-object \
  --compartment-id "${COMPARTMENT_ID}" \
  --namespace "${NAMESPACE}" --bucket-name "${BUCKET}" \
  --name "${IMAGE_NAME}.qcow2" \
  --display-name "${IMAGE_NAME}" \
  --launch-mode CUSTOM \
  --source-image-type QCOW2 \
  --query "data.id" --raw-output)

echo ""
echo "Image imported: ${IMAGE_OCID}"
echo "Next: pulumi config set oci_image_id ${IMAGE_OCID}  (in projects/kazimierz.akn/src/infrastructure/pulumi)"
