apiVersion: arcane.chezmoi.sh/v1alpha1
kind: ApplicationPatch
metadata: {}
spec:
  info:
    # -- Application metadata
    - name: Description
      value: >-
        Grafana Operator + the fleet's single Grafana instance (issue 1159).
        Dashboards/datasources are authored per-cluster next to each cluster's
        own apps, but all target this one instance.
    - name: Category
      value: Observability
    # -- Documentation & Resources
    - name: Grafana Operator Docs
      value: https://grafana.github.io/grafana-operator/docs/
    - name: GitHub Repository
      value: https://github.com/grafana/grafana-operator

  syncPolicy:
    automated:
      enabled: true
