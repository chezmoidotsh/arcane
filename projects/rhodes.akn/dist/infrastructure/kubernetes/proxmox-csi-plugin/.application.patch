apiVersion: arcane.chezmoi.sh/v1alpha1
kind: ApplicationPatch
metadata: {}
spec:
  info:
    # -- Application metadata
    - name: Description
      value: CSI plugin for dynamic block-volume provisioning on Proxmox VE storage backends
    - name: Category
      value: Storage / Block Storage
    - name: Version
      # renovate: datasource=helm depName=proxmox-csi-plugin registryUrl=oci://ghcr.io/sergelogvinov/charts
      value: "0.5.7"
    # -- Documentation & Resources
    - name: Documentation
      value: https://github.com/sergelogvinov/proxmox-csi-plugin/blob/main/docs/options.md
    - name: GitHub Repository
      value: https://github.com/sergelogvinov/proxmox-csi-plugin
    - name: Helm Chart
      value: oci://ghcr.io/sergelogvinov/charts/proxmox-csi-plugin

  syncPolicy:
    automated:
      enabled: false # Manual apply until Pulumi-delivered token_secret wiring (#370) lands; avoid automatic updates due to potential storage disruptions
