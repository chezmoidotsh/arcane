vars: {
  d2-config: {
    layout-engine: elk
    sketch: true
  }
}

...@"../../docs/assets/d2/styles.architecture.d2"

explanation: |md
  # lungmen.akn Architecture

  This document describes the architecture \
  of the lungmen.akn platform in a visual way \
  with all the components and how they \
  interact with each other.

  lungmen.akn serves as the home applications \
  cluster, providing media, life management, \
  and personal productivity services for \
  the homelab infrastructure.
| {
  near: top-left
}

# ╭────────────────────────────────────────────────────────────────────────────╮
# │                              External Objects                              │
# ├────────────────────────────────────────────────────────────────────────────┤
# │ Desc:                                                                      │
# │   These objects represent resources external to the lungmen.akn platform   │
# │   but which interact with or are used by it.                               │
# │   They include networks, hardware, or third-party services                 │
# │   essential for the proper functioning, connectivity, security,            │
# │   or management of the platform.                                           │
# ╰────────────────────────────────────────────────────────────────────────────╯

# ──────────────────────────────────────────────────────────────────────────────
# Networks

internet: {class: network}
localnet: {class: network}
tailnet: {
  class: network
  tooltip: Tailnet - Mesh VPN Network
}

# ──────────────────────────────────────────────────────────────────────────────
# Hardware & Infrastructure

udm-pro: {
  class: hardware
  icon: docs/assets/icons/hardware/ubiquiti_unifi.svg
  tooltip: UniFi Dream Machine Pro - Gateway & Network Controller
}

# ──────────────────────────────────────────────────────────────────────────────
# External Clusters

rhodes·akn: {
  class: [application]
  label: rhodes·akn
  icon: ../rhodes.akn/docs/assets/logo.light.svg # light variant: this diagram renders with the default (light) theme
  tooltip: Mission-critical services cluster (SSO, Secrets, etc.)

  pocket-id: {
    class: [application]
    icon: docs/assets/icons/apps/pocket-id.svg
    label: auth.chezmoi.sh
    link: https://pocket-id.org/
    tooltip: Pocket-ID is an open-source identity and access management solution based only on passkeys.
  }

  openbao: {
    class: [application]
    icon: docs/assets/icons/apps/openbao.svg
    label: vault.chezmoi.sh
    link: https://openbao.org/
    tooltip: OpenBao is an open-source, community-driven fork of Vault managed by the Linux Foundation.
  }
}

kazimierz·akn: {
  class: [application]
  label: kazimierz·akn
  icon: ../kazimierz.akn/docs/assets/logo.light.svg
  tooltip: Public gateway cluster (Pangolin, WAF, etc.)

  pangolin: {
    class: [application]
    icon: docs/assets/icons/system/pangolin.svg
    label: pangolin.chezmoi.sh
    link: https://github.com/fosrl/pangolin
    tooltip: Pangolin is a reverse proxy and WAF that provides secure access to homelab services.
  }
}

# ──────────────────────────────────────────────────────────────────────────────
# Hardware & Infrastructure

nas: {
  class: namespace
  label: TrueNAS Scale
  icon: docs/assets/icons/hardware/truenas-scale.svg
  tooltip: Home Network Attached Storage (NAS)

  garage: {
    class: [application]
    label: Garage (s3.chezmoi.sh)
    icon: docs/assets/icons/apps/garage.svg
    link: https://garagehq.deuxfleurs.fr/
    tooltip: Garage is a lightweight S3-compatible distributed object storage system.
  }
}

# ╭────────────────────────────────────────────────────────────────────────────╮
# │                            lungmen.akn Platform                            │
# ├────────────────────────────────────────────────────────────────────────────┤
# │ Desc:                                                                      │
# │   This namespace contains all the components of the lungmen.akn platform,  │
# │   serving as the home applications cluster providing media, life           │
# │   management, and personal productivity services for the homelab.          │
# ╰────────────────────────────────────────────────────────────────────────────╯

lungmen·akn: {
  icon: docs/assets/logo.svg
  style.fill-pattern: none

  system: {class: namespace}
  media: {class: namespace}
  life: {class: namespace}
  others: {class: namespace}
  databases: {class: namespace}

  # ────────────────────────────────────────────────────────────────────────────
  # Shared Databases

  databases.apps: {
    class: [application-datastore]
    label: "apps"
    icon: docs/assets/icons/system/cloudnativepg.svg
    link: https://postgresql.org/
    tooltip: Shared PostgreSQL cluster (CloudNative-PG) used by Linkding (and the other small apps), with automated backups to S3.
  }

  databases.apps-secured: {
    class: [application-datastore]
    label: "apps-secured"
    icon: docs/assets/icons/system/cloudnativepg.svg
    link: https://postgresql.org/
    tooltip: Shared PostgreSQL cluster (CloudNative-PG) with VectorChord, used by Immich and Paperless-ngx, with automated backups to S3.
  }

  # ────────────────────────────────────────────────────────────────────────────
  # System Components

  system.cert-manager: {
    class: [application-system]
    label: Cert-Manager
    icon: docs/assets/icons/system/cert-manager.svg
    link: https://cert-manager.io/
    tooltip: Cert-Manager is a Kubernetes controller that automates the management and issuance of TLS certificates.
  }

  system.cilium: {
    class: [application-system]
    label: Cilium
    icon: docs/assets/icons/system/cilium.svg
    link: https://cilium.io/
    tooltip: Cilium is a networking, observability, and security solution with an eBPF-based dataplane.
  }

  system.cloudnativepg: {
    class: [application-system]
    label: CloudNativePG
    icon: docs/assets/icons/system/cloudnativepg.svg
    link: https://cloudnativepg.io/
    tooltip: CloudNativePG is a comprehensive platform designed to seamlessly manage PostgreSQL databases within Kubernetes environments.
  }

  system.cilium-gateway: {
    class: [application-system]
    label: Cilium Gateway
    icon: docs/assets/icons/system/cilium.svg
    link: https://docs.cilium.io/en/stable/network/servicemesh/gateway-api/gateway-api/
    tooltip: Cilium Gateway API implementation (external and internal gateways) routing HTTP traffic to the applications.
  }

  system.external-dns: {
    class: [application-system]
    label: ExternalDNS
    icon: docs/assets/icons/system/external-dns.png
    link: https://github.com/kubernetes-sigs/external-dns
    tooltip: ExternalDNS configures DNS records automatically for exposed services.
  }

  system.external-secrets: {
    class: [application-system]
    label: External-Secret
    icon: docs/assets/icons/system/external-secret.svg
    link: https://external-secrets.io/
    tooltip: External-Secret is a Kubernetes controller that allows you to use external secret management systems.
  }

  system.tailscale: {
    class: [application-system]
    label: Tailscale
    icon: docs/assets/icons/platform/tailscale.svg
    link: https://tailscale.com/
    tooltip: TailScale is a mesh VPN that makes it easy to connect your devices, wherever they are.
  }

  system.newt: {
    class: [application-system]
    label: Newt
    icon: docs/assets/icons/system/pangolin.svg
    link: https://github.com/fosrl/newt
    tooltip: Newt is a client for Pangolin that establishes a secure tunnel to the public gateway.
  }

  # ────────────────────────────────────────────────────────────────────────────
  # Media Components

  media.immich-stack: {
    class: [namespace]
    label: Immich Stack
    tooltip: Immich photo and video management stack with Redis cache (PostgreSQL on the shared cluster)

    immich: {
      class: [application]
      label: Immich
      icon: docs/assets/icons/apps/immich.svg
      link: https://immich.app/
      tooltip: High-performance self-hosted photo and video management solution with mobile app support.
    }

    redis: {
      class: [application-datastore]
      label: Redis
      icon: docs/assets/icons/apps/redis.svg
      link: https://redis.io/
      tooltip: Redis cache for improved Immich performance and background task processing.
    }
  }

  media.jellyfin: {
    class: [application]
    label: Jellyfin
    icon: docs/assets/icons/apps/jellyfin.svg
    link: https://jellyfin.org/
    tooltip: Volunteer-built media solution that puts you in control of your media.
  }

  # ────────────────────────────────────────────────────────────────────────────
  # Life Management Components

  life.actual-budget: {
    class: [application]
    label: Actual Budget
    icon: docs/assets/icons/apps/actual-budget.png
    link: https://actualbudget.com/
    tooltip: Personal finance app that helps you track your spending and save money.
  }

  life.paperless-stack: {
    class: [namespace]
    label: Paperless Stack
    tooltip: Paperless document management stack with Redis cache (PostgreSQL on the shared cluster)

    paperless: {
      class: [application]
      label: Paperless-ngx
      icon: docs/assets/icons/apps/paperless.svg
      link: https://docs.paperless-ngx.com/
      tooltip: Document management system to store, search and share documents.
    }

    redis: {
      class: [application-datastore]
      label: Redis
      icon: docs/assets/icons/apps/redis.svg
      link: https://redis.io/
      tooltip: Redis cache for improved Paperless performance and background task processing.
    }
  }

  # ────────────────────────────────────────────────────────────────────────────
  # Other Components

  others.linkding-stack: {
    class: [namespace]
    label: Linkding Stack
    tooltip: Linkding bookmarking stack (PostgreSQL on the shared cluster)

    linkding: {
      class: [application]
      label: Linkding
      icon: docs/assets/icons/apps/linkding.svg
      link: https://github.com/sissbruecker/linkding
      tooltip: Self-hosted bookmarking and link aggregation service with OIDC authentication.
    }
  }

}

# ╭────────────────────────────────────────────────────────────────────────────╮
# │                                Connections                                 │
# ├────────────────────────────────────────────────────────────────────────────┤
# │ Desc:                                                                      │
# │   This section describes the various connections within the lungmen.akn    │
# │   platform and its interactions with external systems.                     │
# ╰────────────────────────────────────────────────────────────────────────────╯

# ──────────────────────────────────────────────────────────────────────────────
# Network to Platform Flow

localnet -> lungmen·akn.system.cilium-gateway: |md
  HTTP (80)
  HTTPS (443)
|

tailnet -> lungmen·akn.system.tailscale: {class: [connect-vpn-backbone]}

# ──────────────────────────────────────────────────────────────────────────────
# System Connections

lungmen·akn.system.cert-manager -> internet: "ACME certificate validation (443)" {class: [connect-to-internet]}

lungmen·akn.system.external-dns -> udm-pro: "Automated DNS record management (443)"

lungmen·akn.system.external-secrets -> rhodes·akn.openbao: "Secure secrets retrieval from vault (443)"

lungmen·akn.system.tailscale -> internet: "VPN tunnel establishment (443)" {class: [connect-to-internet]}

lungmen·akn.system.newt -> kazimierz·akn.pangolin: "Secure tunnel establishment (443, 51820/UDP)" {class: [connect-to-internet]}

# ──────────────────────────────────────────────────────────────────────────────
# Media Services Flow

lungmen·akn.media.immich-stack.immich -> rhodes·akn.pocket-id: "SSO authentication (443)"
lungmen·akn.media.immich-stack.immich -> lungmen·akn.databases.apps-secured: "Database operations (5432)"
lungmen·akn.media.immich-stack.immich -> lungmen·akn.media.immich-stack.redis: "Cache operations (6379)"
lungmen·akn.media.immich-stack.immich <- lungmen·akn.system.cilium-gateway: "HTTP traffic proxy (2283)"
lungmen·akn.media.immich-stack.immich <- lungmen·akn.system.newt: "Tunnel traffic proxy (2283)" {class: [secured-connect-from-internet]}

lungmen·akn.media.jellyfin -> rhodes·akn.pocket-id: "SSO authentication (443)"
lungmen·akn.media.jellyfin -> internet: "Metadata and external content fetching (443)" {class: [connect-to-internet]}
lungmen·akn.media.jellyfin <- lungmen·akn.system.cilium-gateway: "HTTP traffic proxy (8096)"
lungmen·akn.media.jellyfin <- lungmen·akn.system.newt: "Tunnel traffic proxy (8096)" {class: [secured-connect-from-internet]}

# ──────────────────────────────────────────────────────────────────────────────
# Life Management Flow

lungmen·akn.life.actual-budget -> rhodes·akn.pocket-id: "SSO authentication (443)"
lungmen·akn.life.actual-budget <- lungmen·akn.system.cilium-gateway: "HTTP traffic proxy (5006)"

lungmen·akn.life.paperless-stack.paperless -> rhodes·akn.pocket-id: "SSO authentication (443)"
lungmen·akn.life.paperless-stack.paperless -> lungmen·akn.databases.apps-secured: "Database operations (5432)"
lungmen·akn.life.paperless-stack.paperless -> lungmen·akn.life.paperless-stack.redis: "Cache operations (6379)"
lungmen·akn.life.paperless-stack.paperless <- lungmen·akn.system.cilium-gateway: "HTTP traffic proxy (8000)"
lungmen·akn.life.paperless-stack.paperless -> internet: "IMAP email access (993)" {class: [connect-to-internet]}

# ──────────────────────────────────────────────────────────────────────────────
# Other Services Flow

lungmen·akn.others.linkding-stack.linkding -> rhodes·akn.pocket-id: "SSO authentication (443)"
lungmen·akn.others.linkding-stack.linkding -> lungmen·akn.databases.apps: "Database operations (5432)"
lungmen·akn.others.linkding-stack.linkding -> internet: "Website information fetching (443)" {class: [connect-to-internet]}
lungmen·akn.others.linkding-stack.linkding <- lungmen·akn.system.cilium-gateway: "HTTP traffic proxy (9090)"
lungmen·akn.others.linkding-stack.linkding <- lungmen·akn.system.newt: "Tunnel traffic proxy (9090)" {class: [secured-connect-from-internet]}

# ──────────────────────────────────────────────────────────────────────────────
# Shared Databases Flow

lungmen·akn.databases.apps -> nas.garage: "Database backups (S3, 443)"
lungmen·akn.databases.apps <- lungmen·akn.system.cloudnativepg: "Database management" {class: [connect-management]}
lungmen·akn.databases.apps-secured -> nas.garage: "Database backups (S3, 443)"
lungmen·akn.databases.apps-secured <- lungmen·akn.system.cloudnativepg: "Database management" {class: [connect-management]}
