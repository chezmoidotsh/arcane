apiVersion: arcane.chezmoi.sh/v1alpha1
kind: ApplicationPatch
metadata: {}
spec:
  info:
    # -- Application metadata
    - name: Description
      value: Periodically evicts pods from over-utilized nodes so the scheduler can rebalance them
    - name: Category
      value: Scheduling
    - name: Version
      # renovate: datasource=helm depName=descheduler registryUrl=https://kubernetes-sigs.github.io/descheduler/
      value: "0.37.0"
    # -- Documentation & Resources
    - name: Documentation
      value: https://github.com/kubernetes-sigs/descheduler#readme
    - name: GitHub Repository
      value: https://github.com/kubernetes-sigs/descheduler
    - name: Helm Chart
      value: https://artifacthub.io/packages/helm/descheduler/descheduler

  syncPolicy:
    automated:
      enabled: true
