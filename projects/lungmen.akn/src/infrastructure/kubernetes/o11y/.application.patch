apiVersion: arcane.chezmoi.sh/v1alpha1
kind: ApplicationPatch
metadata: {}
spec:
  info:
    # -- Application metadata
    - name: Description
      value: >-
        Grafana Operator (issue 1159) -- no local Grafana instance here, only
        an external-mode reference to the single instance on rhodes.akn, plus
        this cluster's own GrafanaDashboard CRs.
    - name: Category
      value: Observability
    # -- Documentation & Resources
    - name: Grafana Operator Docs
      value: https://grafana.github.io/grafana-operator/docs/
    - name: GitHub Repository
      value: https://github.com/grafana/grafana-operator

  syncPolicy:
    automated:
      enabled: true
