#!/usr/bin/env bash
#MISE description="Check that the log formats known by the OPA rule OBS001 match the o11y-agent parser directories"
#
# OBS001 (policies/opa/OBS001:kubernetes.rego) rejects a log format
# that is not in its `log_formats` set. That set must list exactly the parser
# directories of catalog/kubernetes/o11y-agent/parsers, plus `none` (ADR-020):
# a format missing from the set cannot be declared, a format with no parser
# is never parsed.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
PARSERS="${REPO_ROOT}/catalog/kubernetes/o11y-agent/parsers"
POLICY="${REPO_ROOT}/policies/opa/OBS001:kubernetes.rego"

declared="$(sed -n '/^log_formats := {/,/^}/p' "${POLICY}" | grep -o '"[^"]*"' | tr -d '"' | grep -vx none | sort)"
available="$(for k in "${PARSERS}"/*/kustomization.yaml; do basename "$(dirname "${k}")"; done | sort)"

# Findings are `path:line: message` lines (the format rtunk parses, .rtunk/local-plugin/linters/o11y-log-formats/).
rel="${POLICY#"${REPO_ROOT}/"}"
line="$(grep -n '^log_formats := {' "${POLICY}" | cut -d: -f1)"
status=0
extra="$(comm -13 <(echo "${declared}") <(echo "${available}") || true)"
missing="$(comm -23 <(echo "${declared}") <(echo "${available}") || true)"
while IFS= read -r format; do
	[[ -n ${format} ]] || continue
	echo "${rel}:${line}: parser '${format}' exists but is not in log_formats"
	status=1
done <<<"${extra}"
while IFS= read -r format; do
	[[ -n ${format} ]] || continue
	echo "${rel}:${line}: log_formats lists '${format}' but there is no such parser directory"
	status=1
done <<<"${missing}"
((status == 0)) || exit 1
count="$(grep -c . <<<"${available}")"
echo "OBS001 knows the ${count} parser formats, plus none"
