#!/usr/bin/env bash
#MISE description="Regenerate the DERP egress policy of lungmen.akn from Tailscale's DERP map"
#USAGE flag "--check" help="Do not write anything, exit 1 if the policy is out of date (for CI)"
#USAGE flag "--no-render" help="Do not run dist:render after updating the policy"
#
# tailscaled dials the DERP relays and STUN servers by the IP addresses of the DERP map,
# without a DNS lookup, so a Cilium toFQDNs rule can never allow them. This task builds a
# strict toCIDR list (TCP 443 + UDP 3478) from the official map instead. The relays change
# over time: run it regularly, or with --check in a scheduled job.
#
# Requires: curl, jq.
set -euo pipefail

DERPMAP_URL="https://controlplane.tailscale.com/derpmap/default"
POLICY="projects/lungmen.akn/src/infrastructure/kubernetes/tailscale/security/network-policy.allow-tailscale-to-derp.yaml"
RENDER_DIR="projects/lungmen.akn/src/infrastructure/kubernetes/tailscale"
# A broken response must never wipe the policy: the real map has dozens of relays.
MIN_RELAYS=20

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "${REPO_ROOT}"

DERPMAP="$(curl --fail --silent --show-error --max-time 30 "${DERPMAP_URL}")"
# `while read` instead of mapfile: the bash 3.2 shipped with macOS has no mapfile.
RAW_ADDRESSES="$(jq -r '.Regions[].Nodes[]?.IPv4 | select(. != null)' <<<"${DERPMAP}")"
SORTED_ADDRESSES="$(sort -uV <<<"${RAW_ADDRESSES}")"
ADDRESSES=()
while IFS= read -r address; do
	ADDRESSES+=("${address}")
done <<<"${SORTED_ADDRESSES}"

if ((${#ADDRESSES[@]} < MIN_RELAYS)); then
	echo "Only ${#ADDRESSES[@]} relay addresses found in ${DERPMAP_URL} (expected at least ${MIN_RELAYS}), refusing to continue." >&2
	exit 1
fi

GENERATED="$(mktemp)"
trap 'rm -f "${GENERATED}"' EXIT

{
	cat <<'HEADER'
# Generated by `mise run tailscale:derp:update` from https://controlplane.tailscale.com/derpmap/default.
# Do not edit by hand: the list of relays changes over time.
apiVersion: cilium.io/v2
kind: CiliumNetworkPolicy
metadata:
  annotations:
    policy.networking.k8s.io/description: |
      Allows the Tailscale operator and proxies to reach the DERP relays and STUN servers
      of the DERP map: HTTPS (TCP 443) and STUN (UDP 3478), nothing else.
      This cannot be a toFQDNs list. tailscaled dials the relays directly by the IP addresses
      of the DERP map, without resolving their names, so Cilium never learns them from a DNS
      answer. Regenerate the list with `mise run tailscale:derp:update`.
      Direct WireGuard connections to peers (UDP) are not allowed: traffic goes through the
      relays over HTTPS. IPv6 is not used by the cluster, only IPv4 addresses are listed.
  name: allow-tailscale-to-derp
spec:
  endpointSelector: {}
  egress:
    - toCIDR:
HEADER
	for address in "${ADDRESSES[@]}"; do
		echo "        - ${address}/32"
	done
	cat <<'FOOTER'
      toPorts:
        - ports:
            - port: "443"
              protocol: TCP
            - port: "3478"
              protocol: UDP
FOOTER
} >"${GENERATED}"

if [[ -f ${POLICY} ]] && cmp -s "${GENERATED}" "${POLICY}"; then
	echo "${POLICY} is up to date (${#ADDRESSES[@]} relays)."
	exit 0
fi

if [[ ${usage_check:-false} == "true" ]]; then
	echo "${POLICY} is out of date (${#ADDRESSES[@]} relays in the DERP map), run: mise run tailscale:derp:update" >&2
	exit 1
fi

cp "${GENERATED}" "${POLICY}"
echo "Updated ${POLICY} (${#ADDRESSES[@]} relays)."

if [[ ${usage_no_render:-false} != "true" ]]; then
	dist:render "${RENDER_DIR}"
fi
