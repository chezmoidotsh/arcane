#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# ///
"""Redact secrets from stdin using gitleaks, print the sanitized content to stdout.

Used as a Bash output filter (see .claude/settings.json PreToolUse hook) so that
tokens, keys, and other credentials never reach the model's context.
"""
from __future__ import annotations

import json
import shutil
import subprocess
import sys
import tempfile


def main() -> None:
    content = sys.stdin.buffer.read()

    if shutil.which("gitleaks") is None:
        # Fail open rather than crash the whole Bash pipeline: an environment
        # missing gitleaks (e.g. `mise install` never ran) should not take
        # down every Bash tool call just because output can't be redacted.
        print("redact-secrets: gitleaks not found on PATH, passing output through unredacted", file=sys.stderr)
        sys.stdout.buffer.write(content)
        return

    with tempfile.NamedTemporaryFile(suffix=".json") as report:
        subprocess.run(
            ["gitleaks", "detect", "--pipe", "--no-color", "-l", "error", "-r", report.name],
            input=content,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        # gitleaks writes its report atomically (write-then-rename), which swaps in a
        # new inode at report.name -- re-open by path rather than reusing the stale fd.
        findings = json.loads(open(report.name, "rb").read() or b"[]")

    for finding in findings:
        secret = finding.get("Secret", "").encode()
        if secret:
            content = content.replace(secret, f"[REDACTED:{finding['RuleID']}]".encode())

    sys.stdout.buffer.write(content)


if __name__ == "__main__":
    main()
