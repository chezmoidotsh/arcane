vars: {
  d2-config: {
    layout-engine: elk
    sketch: true
  }
}

...@"../../../docs/assets/d2/styles.blueprint.d2"

direction: right

# ── Outside the cluster ────────────────────────────────────────────────────────

internet: {
  class: network
  label.near: bottom-center

  pangolin: {
    class: platform
    label: "Pangolin\n(public gateway)"
    icon: assets/icons/system/pangolin.blueprint.svg
  }
}

localnet: {
  class: network
  label.near: bottom-center

  pocket-id: {
    class: hardware
    label: "Pocket-Id\n(rhodes.akn)"
    icon: assets/icons/apps/pocket-id.blueprint.svg
  }

  nas: {
    class: hardware
    label: TrueNAS
    icon: assets/icons/hardware/truenas-scale.blueprint.svg
  }

  garage: {
    class: hardware
    label: Garage
    icon: assets/icons/apps/garage.blueprint.svg
  }
}

# ── lungmen.akn ────────────────────────────────────────────────────────────────

lungmen·akn: {
  class: [project]

  applications: {class: namespace}

  gateway: {
    class: [application-system]
    label: Cilium Gateway
    icon: assets/icons/system/cilium.blueprint.svg
  }

  newt: {
    class: [application-system]
    label: Newt
    icon: assets/icons/system/pangolin.blueprint.svg
  }

  applications.jellyfin: {
    class: [application]
    label: Jellyfin
    icon: assets/icons/apps/jellyfin.blueprint.svg
  }

  applications.immich: {
    class: [application]
    label: Immich
    icon: assets/icons/apps/immich.blueprint.svg
  }

  applications.paperless: {
    class: [application]
    label: Paperless-ngx
    icon: assets/icons/apps/paperless.blueprint.svg
  }

  applications.actual: {
    class: [application]
    label: Actual Budget
    icon: assets/icons/apps/actual-budget.blueprint.svg
  }

  applications.homebox: {
    class: [application]
    label: Homebox
    icon: assets/icons/apps/homebox.blueprint.svg
  }

  applications.linkding: {
    class: [application]
    label: Linkding
    icon: assets/icons/apps/linkding.blueprint.svg
  }

  applications.spoolman: {
    class: [application]
    label: Spoolman
    icon: assets/icons/apps/spoolman.blueprint.svg
  }

  applications.n8n: {
    class: [application]
    label: n8n
    icon: assets/icons/apps/n8n.blueprint.svg
  }

  apps-db: {
    class: [application-datastore]
    label: apps
    icon: assets/icons/system/cloudnativepg.blueprint.svg
  }

  secured-db: {
    class: [application-datastore]
    label: apps-secured
    icon: assets/icons/system/cloudnativepg.blueprint.svg
  }

  redis: {
    class: [application-datastore]
    label: Redis
    icon: assets/icons/apps/redis.blueprint.svg
  }
}

# ── Flows ──────────────────────────────────────────────────────────────────────

localnet.users: {
  class: hardware
  label: Home network
  icon: assets/icons/hardware/ubiquiti_unifi.blueprint.svg
}

localnet.users -> lungmen·akn.gateway: "Browse apps (HTTPS)" {target-arrowhead: 443; class: [connect-local]}

lungmen·akn.gateway -> lungmen·akn.applications: "Route (HTTP)" {class: [connect-app]}
lungmen·akn.applications -> localnet.pocket-id: "Authenticate (OIDC)" {target-arrowhead: 443; class: [connect-local]}

lungmen·akn.newt -> internet.pangolin: "Open tunnel (HTTPS)" {target-arrowhead: 443; class: [connect-to-internet]}
lungmen·akn.newt -> lungmen·akn.applications.immich: "Public photos" {class: [connect-app]}
lungmen·akn.newt -> lungmen·akn.applications.jellyfin: "Public streaming" {class: [connect-app]}
lungmen·akn.newt -> lungmen·akn.applications.n8n: "Private editor" {class: [connect-app]}


lungmen·akn.applications.immich -> lungmen·akn.secured-db: "Store" {target-arrowhead: 5432; class: [connect-app]}
lungmen·akn.applications.paperless -> lungmen·akn.secured-db: "Store" {target-arrowhead: 5432; class: [connect-app]}
lungmen·akn.applications.n8n -> lungmen·akn.secured-db: "Store" {target-arrowhead: 5432; class: [connect-app]}
lungmen·akn.applications.homebox -> lungmen·akn.apps-db: "Store" {target-arrowhead: 5432; class: [connect-app]}
lungmen·akn.applications.linkding -> lungmen·akn.apps-db: "Store" {target-arrowhead: 5432; class: [connect-app]}
lungmen·akn.applications.spoolman -> lungmen·akn.apps-db: "Store" {target-arrowhead: 5432; class: [connect-app]}

lungmen·akn.applications.immich -> lungmen·akn.redis: "Cache" {target-arrowhead: 6379; class: [connect-app]}
lungmen·akn.applications.paperless -> lungmen·akn.redis: "Queue" {target-arrowhead: 6379; class: [connect-app]}
lungmen·akn.applications.n8n -> lungmen·akn.redis: "Queue" {target-arrowhead: 6379; class: [connect-app]}

lungmen·akn.applications.immich -> localnet.nas: "Mount media (SMB)" {class: [connect-local]}
lungmen·akn.applications.jellyfin -> localnet.nas: "Mount media (SMB)" {class: [connect-local]}
lungmen·akn.applications.paperless -> localnet.nas: "Mount documents (SMB)" {class: [connect-local]}

lungmen·akn.apps-db -> localnet.garage: "Back up (S3)" {target-arrowhead: 443; class: [connect-local]}
lungmen·akn.secured-db -> localnet.garage: "Back up (S3)" {target-arrowhead: 443; class: [connect-local]}
lungmen·akn.applications.homebox -> localnet.garage: "Attachments (S3)" {target-arrowhead: 443; class: [connect-local]}
lungmen·akn.applications.n8n -> localnet.garage: "Binary data (S3)" {target-arrowhead: 443; class: [connect-local]}
