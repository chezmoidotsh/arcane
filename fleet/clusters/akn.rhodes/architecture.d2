vars: {
  d2-config: {
    layout-engine: elk
    sketch: true
  }
}

...@"../../../docs/assets/d2/styles.blueprint.d2"

direction: right

# Services of rhodes.akn and what they talk to. Infrastructure (Cilium, cert-manager,
# External Secrets, CloudNative-PG, Proxmox CSI/CCM) is left out: no service flow depends
# on seeing it here.

internet-in: {
  class: network
  label: internet
  label.near: bottom-center

  pangolin: {
    class: platform
    label: "Pangolin\n(VPS)"
    icon: assets/icons/system/pangolin.blueprint.svg
  }
}

internet: {
  class: network
  label.near: bottom-center

  github: {
    class: platform
    label: GitHub
    icon: assets/icons/platform/github.blueprint.svg
  }

  mailjet: {
    class: platform
    label: Mailjet
    icon: assets/icons/platform/mailjet.blueprint.svg
  }
}

localnet: {
  class: network
  label.near: bottom-center

  other-clusters: {
    class: hardware
    label: Kubernetes clusters
    icon: assets/icons/system/kubernetes.blueprint.svg
  }

  garage: {
    class: hardware
    label: Garage
    icon: assets/icons/apps/garage.blueprint.svg
  }

  o11y-backend: {
    class: hardware
    label: "Observability appliance\n(VictoriaMetrics, VictoriaLogs, VictoriaTraces)"
    icon: assets/icons/system/victoriametrics.blueprint.svg
  }
}

rhodes·akn: {
  class: [project]

  argocd: {
    class: [application]
    label: ArgoCD
    icon: assets/icons/apps/argo-cd.blueprint.svg
  }

  openbao-stack: {
    class: [namespace]
    label: OpenBao

    openbao: {
      class: [application]
      label: OpenBao
      icon: assets/icons/apps/openbao.blueprint.svg
    }

    postgresql: {
      class: [application-datastore]
      label: PostgreSQL
      icon: assets/icons/system/cloudnativepg.blueprint.svg
    }
  }

  pocket-id-stack: {
    class: [namespace]
    label: Pocket-Id

    pocket-id: {
      class: [application]
      label: Pocket-Id
      icon: assets/icons/apps/pocket-id.blueprint.svg
    }

    postgresql: {
      class: [application-datastore]
      label: PostgreSQL
      icon: assets/icons/system/cloudnativepg.blueprint.svg
    }
  }

  grafana-stack: {
    class: [namespace]
    label: Grafana

    grafana: {
      class: [application]
      label: Grafana
      icon: assets/icons/system/grafana.blueprint.svg
    }

    postgresql: {
      class: [application-datastore]
      label: PostgreSQL
      icon: assets/icons/system/cloudnativepg.blueprint.svg
    }
  }

  mcp-o11y: {
    class: [application]
    label: "MCP o11y\n(vMCP)"
    icon: assets/icons/apps/toolhive.blueprint.svg
  }
}

# ── Web interfaces ─────────────────────────────────────────────────────────────

internet-in.pangolin -> rhodes·akn.pocket-id-stack.pocket-id: "Publish login (tunnel)" {class: [connect-from-internet]}
internet-in.pangolin -> rhodes·akn.grafana-stack.grafana: "Publish dashboards (tunnel)" {class: [connect-from-internet]}
internet-in.pangolin -> rhodes·akn.mcp-o11y: "Private access (Pangolin client)" {class: [connect-vpn]}

# ── Between services ───────────────────────────────────────────────────────────

rhodes·akn.argocd -> rhodes·akn.pocket-id-stack.pocket-id: "Authenticate users (OIDC)" {class: [connect-app]}
rhodes·akn.grafana-stack.grafana -> rhodes·akn.pocket-id-stack.pocket-id: "Authenticate users (OIDC)" {class: [connect-app]}
rhodes·akn.mcp-o11y -> rhodes·akn.pocket-id-stack.pocket-id: "Authenticate clients (OIDC)" {class: [connect-app]}
rhodes·akn.mcp-o11y -> rhodes·akn.grafana-stack.grafana: "Query dashboards (HTTP)" {target-arrowhead: 3000; class: [connect-app]}

rhodes·akn.openbao-stack.openbao -> rhodes·akn.openbao-stack.postgresql: "Store secrets" {target-arrowhead: 5432; class: [connect-app]}
rhodes·akn.pocket-id-stack.pocket-id -> rhodes·akn.pocket-id-stack.postgresql: "Store users" {target-arrowhead: 5432; class: [connect-app]}
rhodes·akn.grafana-stack.grafana -> rhodes·akn.grafana-stack.postgresql: "Store dashboards" {target-arrowhead: 5432; class: [connect-app]}

# ── Outside the cluster ────────────────────────────────────────────────────────

rhodes·akn.openbao-stack.postgresql -> localnet.garage: "Back up (S3)" {class: [connect-local]}
rhodes·akn.pocket-id-stack.postgresql -> localnet.garage: "Back up (S3)" {class: [connect-local]}
rhodes·akn.grafana-stack.postgresql -> localnet.garage: "Back up (S3)" {class: [connect-local]}

rhodes·akn.grafana-stack.grafana -> localnet.o11y-backend: "Query signals (HTTPS)" {target-arrowhead: 443; class: [connect-local]}
rhodes·akn.mcp-o11y -> localnet.o11y-backend: "Query signals (HTTPS)" {target-arrowhead: 443; class: [connect-local]}

localnet.other-clusters -> rhodes·akn.openbao-stack.openbao: "Fetch secrets (HTTPS)" {class: [connect-local]}
localnet.other-clusters -> rhodes·akn.pocket-id-stack.pocket-id: "Authenticate (OIDC)" {class: [connect-local]}
rhodes·akn.argocd -> localnet.other-clusters: "Deploy applications (Kubernetes API)" {target-arrowhead: 6443; class: [connect-management]}

rhodes·akn.argocd -> internet.github: "Sync repository (HTTPS)" {target-arrowhead: 443; class: [connect-to-internet]}
rhodes·akn.pocket-id-stack.pocket-id -> internet.mailjet: "Send emails (SMTPS)" {target-arrowhead: 465; class: [connect-to-internet]}
