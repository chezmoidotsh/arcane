#!/usr/bin/env bash
# [MISE] description="Build the Omni LXC template with secrets baked in"
# [MISE] dir="{{config_root}}"

set -euo pipefail

CONFIG_ROOT="$(pwd)"
# Shared library, left next to the o11y-datastore LXC that still uses it.
# shellcheck source=/dev/null
source "${CONFIG_ROOT}/../../../projects/chezmoi.sh/src/infrastructure/proxmox/lxc/.mise/lib/lxc.sh"

lxc_init "omni" "${CONFIG_ROOT}/nix" _omni
lxc_secret "secrets/caddy.sops.env" CLOUDFLARE_API_TOKEN
lxc_secret "secrets/omni.sops.env" DEX_ADMIN_PASSWORD_HASH
lxc_build
