# ─────────────────────────────────────────────────────────────────────────────
# Caddyfile — data.o11y.chezmoi.sh (see ../../caddy.nix)
# ─────────────────────────────────────────────────────────────────────────────
# The secret comes from the environment, exported by the launchd wrapper:
#   CLOUDFLARE_API_TOKEN — DNS-01 ACME for data.o11y.chezmoi.sh
# ─────────────────────────────────────────────────────────────────────────────

{
  # Prometheus metrics on the admin endpoint (localhost:2019/metrics),
  # scraped by the o11y agent (Caddy cannot push metrics as OTLP).
  metrics
}

# ─── Read snippet (:443) ──────────────────────────────────────────────
# Query APIs and UIs only: every ingest/admin path answers 403, so the
# only way to write is OTLP on :4318. `route` keeps the directive order.
(read) {
  log

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
    -Server
  }

  handle_path /metrics/* {
    route {
      # vmui queries through the /prometheus/ prefix as well.
      @write path /api/v1/write /api/v1/import* /api/v1/admin/* /prometheus/api/v1/write /prometheus/api/v1/import* /prometheus/api/v1/admin/*
      respond @write 403
      # Every API path the vmui bundle calls (all read-only).
      @read path /vmui /vmui/* /flags /api/v1/* /vmalert/api/v1/* /expand-with-exprs /prettify-query /metric-relabel-debug /downsampling-filters-debug /retention-filters-debug /prometheus/api/v1/* /prometheus/vmalert/api/v1/* /prometheus/expand-with-exprs /prometheus/prettify-query /prometheus/metric-relabel-debug /prometheus/downsampling-filters-debug /prometheus/retention-filters-debug
      reverse_proxy @read localhost:8428
      respond 403
    }
  }

  handle_path /logs/* {
    route {
      reverse_proxy /select/* localhost:9428
      respond 403
    }
  }

  handle_path /traces/* {
    route {
      reverse_proxy /select/* localhost:10428
      respond 403
    }
  }

  # Alertmanager: read-only, except silences (create/expire from the UI), from
  # the write sources only (O11Y_SILENCE_SOURCES, set by caddy.nix): the
  # read-only sources reach :443 too. Pushing alerts (POST /api/v2/alerts) and
  # /-/reload, /-/quit are refused.
  handle /alerts/* {
    route {
      @read method GET HEAD
      @silence_create {
        method POST
        path /alerts/api/v2/silences
        remote_ip {$O11Y_SILENCE_SOURCES}
      }
      @silence_expire {
        method DELETE
        path /alerts/api/v2/silence/*
        remote_ip {$O11Y_SILENCE_SOURCES}
      }
      reverse_proxy @read localhost:9093
      reverse_proxy @silence_create localhost:9093
      reverse_proxy @silence_expire localhost:9093
      respond 403
    }
  }

  handle {
    root * /etc/caddy/www
    try_files {path} /index.html
    file_server
  }
}

# ─── OTLP snippet (:4318) ──────────────────────────────────────────────
# Every standard OTLP/HTTP signal path goes to the OTLP gateway
# (otlp-gateway.nix), which accepts JSON and protobuf and forwards
# protobuf to the stores.
(otlp) {
  # No access log: every push of every sender would become a log line, including
  # the appliance's own pushes (a feedback loop). Failures surface in the
  # senders' and the gateway's own logs.

  request_body {
    max_size 64MiB
  }

  handle /v1/* {
    reverse_proxy localhost:14318
  }

  handle {
    respond 404
  }
}

# ─── HTTP → HTTPS redirect ─────────────────────────────────────────────
http://data.o11y.chezmoi.sh {
  redir https://{host}{uri} permanent
}

# ─── HTTPS — LAN hostname, Cloudflare DNS-01 TLS ──────────────────────
https://data.o11y.chezmoi.sh {
  import read
  tls {
    dns cloudflare {env.CLOUDFLARE_API_TOKEN}
  }
}

https://data.o11y.chezmoi.sh:4318 {
  import otlp
  tls {
    dns cloudflare {env.CLOUDFLARE_API_TOKEN}
  }
}
