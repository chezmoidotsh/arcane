vars: {
  d2-config: {
    layout-engine: elk
    sketch: true
  }
}

...@"../../../docs/assets/d2/styles.blueprint.d2"

direction: right

# ╭────────────────────────────────────────────────────────────────────────────╮
# │                              External Objects                              │
# ├────────────────────────────────────────────────────────────────────────────┤
# │ Desc:                                                                      │
# │   Who plays and administers exusiai.akn, and the external services the     │
# │   host depends on (sign-in, certificates, off-site backups).               │
# ╰────────────────────────────────────────────────────────────────────────────╯

players: {
  class: hardware
  label: "Players and\nadministrators"
}

internet: {
  class: network
  label.near: bottom-center

  pocketid: {
    class: platform
    label: "Pocket-Id\n(auth.chezmoi.sh)"
    icon: assets/icons/apps/pocket-id.blueprint.svg
  }

  letsencrypt: {
    class: platform
    label: Let's Encrypt
    icon: assets/icons/platform/letsencrypt.blueprint.svg
  }

  backblaze: {
    class: platform
    label: Backblaze B2
  }
}

tailnet: {
  class: network
  label.near: bottom-center

  admin: {
    class: hardware
    label: Administrator
  }
}

# ╭────────────────────────────────────────────────────────────────────────────╮
# │                              exusiai.akn                                   │
# ├────────────────────────────────────────────────────────────────────────────┤
# │ Desc:                                                                      │
# │   The Pelican Panel and Wings, the Minecraft servers they start, and the   │
# │   components every flow goes through: Caddy, restic and Tailscale.         │
# ╰────────────────────────────────────────────────────────────────────────────╯

exusiai·akn: {
  class: project
  label: exusiai.akn

  caddy: {
    class: application-system
    label: Caddy
    icon: assets/icons/apps/caddy.blueprint.svg
  }

  panel: {
    class: application
    label: Pelican Panel
    icon: assets/icons/apps/pelican-panel.blueprint.svg
  }

  wings: {
    class: application
    label: Pelican Wings
    icon: assets/icons/apps/pelican-panel.blueprint.svg
  }

  minecraft: {
    class: application
    label: Minecraft servers
  }

  restic: {
    class: application-system
    label: restic
  }

  tailscale: {
    class: application-system
    label: Tailscale
    icon: assets/icons/platform/tailscale.blueprint.svg
  }
}

# ╭────────────────────────────────────────────────────────────────────────────╮
# │                                Connections                                 │
# ╰────────────────────────────────────────────────────────────────────────────╯

players -> exusiai·akn.minecraft: "Play (Minecraft Java)" {target-arrowhead: 25565-25580; class: [connect-from-internet]}
players -> exusiai·akn.caddy: "Open the panel and console (HTTPS)" {target-arrowhead: 443; class: [connect-from-internet]}

exusiai·akn.caddy -> exusiai·akn.panel: "Serve minecraft.chezmoi.sh (HTTP)" {target-arrowhead: 81; class: [connect-local]}
exusiai·akn.caddy -> exusiai·akn.wings: "Serve main.minecraft.chezmoi.sh (HTTP)" {target-arrowhead: 8080; class: [connect-local]}
exusiai·akn.panel -> exusiai·akn.wings: "Manage servers (HTTPS)" {class: [connect-app]}
exusiai·akn.wings -> exusiai·akn.minecraft: "Start, stop, back up (Docker)" {class: [connect-local]}
exusiai·akn.panel -> internet.pocketid: "Sign users in (OIDC)" {target-arrowhead: 443; class: [connect-to-internet]}

exusiai·akn.restic -> exusiai·akn.wings: "Read world archives (files)" {class: [connect-local]}
exusiai·akn.restic -> internet.backblaze: "Push encrypted backups (S3)" {target-arrowhead: 443; class: [connect-to-internet]}
exusiai·akn.caddy -> internet.letsencrypt: "Get certificates (ACME HTTP-01)" {target-arrowhead: 443; class: [connect-management-to-internet]}

tailnet.admin -> exusiai·akn.tailscale: "Administer (SSH)" {target-arrowhead: 22; class: [connect-vpn]}
