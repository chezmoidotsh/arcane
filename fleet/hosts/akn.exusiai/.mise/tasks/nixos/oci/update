#!/usr/bin/env bash
#MISE description="Apply the configuration to the running OCI A1 host over the tailnet"
#MISE dir="{{ config_root }}/nix"
#USAGE arg "[target]" default="root@exusiai-akn" help="SSH target on the tailnet (the host switching from rimbilliton-akn is still reached as root@rimbilliton-akn)"
set -euo pipefail

# shellcheck disable=SC2312  # jq failure aborts nonix anyway (invalid flake ref)
nonix run "github:NixOS/nixpkgs/$(jq -r .nodes.nixpkgs.locked.rev flake.lock)#nixos-rebuild" -- switch \
  --flake ".#exusiai-akn-aarch64" --target-host "${usage_target}"
