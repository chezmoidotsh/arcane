#!/usr/bin/env bash
#MISE description="Apply the configuration to the running OCI A1 host over the tailnet"
#MISE dir="{{ config_root }}/nix"
#MISE depends=["nixos:_require-nix"]
#USAGE arg "[target]" default="root@horn-akn" help="SSH target on the tailnet (the host switching from kazimierz-akn is still reached as root@kazimierz-akn)"
set -euo pipefail

mise run nixos:binding-ip
# Built on the host itself: this machine is not an aarch64-linux builder.
nix run .#nixos-rebuild -- switch \
  --flake ".#horn-akn-aarch64" --target-host "${usage_target}" --build-host "${usage_target}"
