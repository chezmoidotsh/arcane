#!/usr/bin/env bash
# [MISE] description="Upload the oci-registry LXC template to Proxmox"
# [MISE] depends=["lxc:build"]
# [MISE] dir="{{config_root}}"
# [USAGE] arg "<pve_host>" help="Hostname or IP of the Proxmox node (e.g. pve.lan)"

set -euo pipefail

CONFIG_ROOT="$(pwd)"
# Shared library, left next to the o11y-datastore LXC that still uses it.
# shellcheck source=/dev/null
source "${CONFIG_ROOT}/../../../projects/chezmoi.sh/src/infrastructure/proxmox/lxc/.mise/lib/lxc.sh"

lxc_init "oci-registry" "${CONFIG_ROOT}/nix" _oci_registry
lxc_push "${usage_pve_host}"
