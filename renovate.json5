{
  // Use the official Renovate schema for validation and IDE auto-completion.
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  // Disable Renovate until the configuration has been reworked to avoid some annoying auto-upgrades.
  "enabled": false,

  // Extend shared configurations. This is great for maintainability.
  "extends": [
    "github>chezmoidotsh/renovate-config",
    "github>chezmoidotsh/renovate-config:github-actions(monthly)",
    "github>chezmoidotsh/renovate-config:gitmoji",
  ],

  // ---
  // PACKAGE RULES
  // ---
  // These rules control how Renovate groups and labels the Pull Requests.
  "packageRules": [
    {
      "description": "Group all updates for the same package name into a single PR",
      "matchDatasources": ["docker", "helm"],
      "groupName": "{{{depName}}}",
    },
    {
      // This rule enables digest updates on Kustomization files.
      "description": "Enable digest updates for Kustomization files",
      "matchDatasources": ["docker"],
      "matchFileNames": ["/(^|/)kustomization\\.ya?ml$/"],
      "pinDigest": true,
    },
  ],
}
